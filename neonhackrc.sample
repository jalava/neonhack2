# Sample NeonHack configuration.  Copy to ~/.neonhackrc and edit.
# Every NetHack option works; these are just suggestions.

OPTIONS=name:Case
# role, race, gender and alignment; NetHack names work too (role:Wizard)
#OPTIONS=role:Netrunner,race:human,gender:female,align:chaotic
OPTIONS=pettype:cat,!autopickup,time,showexp

# the map: NeonGrid is the default on UTF-8 terminals.  Rounded corners
# and dashed doors (Cascadia Mono and similar fonts), or NetHack's ASCII:
#OPTIONS=symset:NeonGrid+
#OPTIONS=symset:default
# NeonGrid colours are 24-bit; for a terminal that only has 256 colours:
#OPTIONS=!use_truecolor

# emoji in some messages (only used on UTF-8 terminals); turn off with
#OPTIONS=!emoji

# the curses interface instead of tty
#OPTIONS=windowtype:curses

# arrows always move, and so do Home/PgUp/End/PgDn (Fn+arrows: Fn turns
# the arrow 45 degrees clockwise, so End is southeast); mouse clicks
# travel (left) and look (right).  Turn the mouse off (then text can be
# selected without holding Shift):
#OPTIONS=!mouse_support
# NetHack's left-click menu of actions instead of travel:
#BIND=mouse1:therecmdmenu

# NeonHack status conditions are on by default; turn them off with
#OPTIONS=!cond_cyberpsycho,!cond_wanted
